digraph G { graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.5", ranksep="0.8", label="Dominio y contratos de Mediterráneo", labelloc=t, fontname="Arial", fontsize=20]; node [shape=plain,fontname="Arial",fontsize=11]; edge [fontname="Arial",fontsize=10,color="#6B4B45",arrowsize=0.7];
cuenta [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#9A3B3B"><TR><TD BGCOLOR="#F6EEDF"><B>Cuenta</B></TD></TR><TR><TD ALIGN="LEFT">id: UUID; email: string</TD></TR><TR><TD ALIGN="LEFT">hash: Argon2id; role: Rol</TD></TR><TR><TD ALIGN="LEFT">verified: bool; active: bool</TD></TR></TABLE>>];
perfil [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#9A3B3B"><TR><TD BGCOLOR="#F6EEDF"><B>PerfilCliente</B></TD></TR><TR><TD ALIGN="LEFT">id: UUID; nombre: string</TD></TR><TR><TD ALIGN="LEFT">RUN y contacto: restringidos</TD></TR></TABLE>>];
sesion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#9A3B3B"><TR><TD BGCOLOR="#F6EEDF"><B>Sesion</B></TD></TR><TR><TD ALIGN="LEFT">jti: UUID; user_id: UUID</TD></TR><TR><TD ALIGN="LEFT">expires: int; revoked: bool</TD></TR></TABLE>>];
pedido [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#9A3B3B"><TR><TD BGCOLOR="#F6EEDF"><B>Pedido</B></TD></TR><TR><TD ALIGN="LEFT">id: UUID; client_id: UUID</TD></TR><TR><TD ALIGN="LEFT">status: EstadoPedido; total: CLP</TD></TR><TR><TD ALIGN="LEFT">creado; motivo; request_key</TD></TR></TABLE>>];
linea [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#9A3B3B"><TR><TD BGCOLOR="#F6EEDF"><B>LineaPedido</B></TD></TR><TR><TD ALIGN="LEFT">producto_id: int; cantidad: int</TD></TR><TR><TD ALIGN="LEFT">nombre y precio historicos</TD></TR><TR><TD ALIGN="LEFT">descuento y subtotal: CLP</TD></TR></TABLE>>];
producto [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#9A3B3B"><TR><TD BGCOLOR="#F6EEDF"><B>Producto</B></TD></TR><TR><TD ALIGN="LEFT">id: int; nombre; categoria</TD></TR><TR><TD ALIGN="LEFT">precio: CLP; stock_libre: int</TD></TR><TR><TD ALIGN="LEFT">activo: bool</TD></TR></TABLE>>];
pago [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#9A3B3B"><TR><TD BGCOLOR="#F6EEDF"><B>Pago</B></TD></TR><TR><TD ALIGN="LEFT">id: UUID; order_id: UUID</TD></TR><TR><TD ALIGN="LEFT">total: CLP; estado: EstadoPago</TD></TR></TABLE>>];
reserva [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#9A3B3B"><TR><TD BGCOLOR="#F6EEDF"><B>ReservaMesa</B></TD></TR><TR><TD ALIGN="LEFT">id: UUID; client_id: UUID</TD></TR><TR><TD ALIGN="LEFT">fecha; personas; estado</TD></TR></TABLE>>];
stock [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#9A3B3B"><TR><TD BGCOLOR="#F6EEDF"><B>ReservaStock</B></TD></TR><TR><TD ALIGN="LEFT">order_id: UUID</TD></TR><TR><TD ALIGN="LEFT">items: LineaReserva[]; estado</TD></TR></TABLE>>];
authsvc [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#9A3B3B"><TR><TD BGCOLOR="#F6EEDF"><B>«service» AuthService</B></TD></TR><TR><TD ALIGN="LEFT">S02 register / login / verify</TD></TR><TR><TD ALIGN="LEFT">S03 logout / resend; S17 users</TD></TR></TABLE>>];
ordersvc [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#9A3B3B"><TR><TD BGCOLOR="#F6EEDF"><B>«service» OrderService</B></TD></TR><TR><TD ALIGN="LEFT">S08 crear; S09 consultar / anular</TD></TR><TR><TD ALIGN="LEFT">S12 estados; S13 / S14 documentos</TD></TR></TABLE>>];
catalogsvc [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#9A3B3B"><TR><TD BGCOLOR="#F6EEDF"><B>«service» CatalogService</B></TD></TR><TR><TD ALIGN="LEFT">S01 products; S15 mantenimiento</TD></TR></TABLE>>];
clientsvc [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#9A3B3B"><TR><TD BGCOLOR="#F6EEDF"><B>«service» ClientService</B></TD></TR><TR><TD ALIGN="LEFT">S05 perfil; S06 contacto</TD></TR><TR><TD ALIGN="LEFT">S07 reservas; S18 / S19 gestion</TD></TR></TABLE>>];
cuenta -> perfil [label="identidad",style="solid",taillabel="1",headlabel="0..1",labeldistance=1.8];
cuenta -> sesion [label="sesiones",style="solid",taillabel="1",headlabel="0..*",labeldistance=1.8];
perfil -> pedido [label="compras",style="solid",taillabel="1",headlabel="0..*",labeldistance=1.8];
perfil -> reserva [label="agenda",style="solid",taillabel="1",headlabel="0..*",labeldistance=1.8];
pedido -> linea [label="composición",arrowtail=diamond,dir=both,arrowhead=none,style="solid",taillabel="1",headlabel="1..*",labeldistance=1.8];
producto -> linea [label="referencia e historial",style="solid",taillabel="1",headlabel="0..*",labeldistance=1.8];
pedido -> pago [label="checkout",style="solid",taillabel="1",headlabel="0..1",labeldistance=1.8];
pedido -> stock [label="reserva",style="solid",taillabel="1",headlabel="0..1",labeldistance=1.8];
authsvc -> cuenta [label="usa",style="dashed",taillabel="",headlabel="",labeldistance=1.8];
ordersvc -> pedido [label="usa",style="dashed",taillabel="",headlabel="",labeldistance=1.8];
catalogsvc -> producto [label="usa",style="dashed",taillabel="",headlabel="",labeldistance=1.8];
clientsvc -> perfil [label="usa",style="dashed",taillabel="",headlabel="",labeldistance=1.8];
comprobante [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#9A3B3B"><TR><TD BGCOLOR="#F6EEDF"><B>ComprobanteDTO</B></TD></TR><TR><TD>numero estable; total; lineas</TD></TR><TR><TD>Documento academico derivado</TD></TR></TABLE>>];
payservice [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#9A3B3B"><TR><TD BGCOLOR="#F6EEDF"><B>«service» PaymentService</B></TD></TR><TR><TD>S10 start; webhook; refund</TD></TR></TABLE>>];
pedido -> comprobante [label="deriva si pagado",taillabel="1",headlabel="0..1",fontsize=10];
payservice -> pago [label="usa",style=dashed];
}
