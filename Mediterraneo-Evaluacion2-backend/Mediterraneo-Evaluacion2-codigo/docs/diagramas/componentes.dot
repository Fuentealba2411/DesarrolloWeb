digraph G { graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.5", ranksep="0.8", label="Procesos separados y autoridad de los datos", labelloc=t, fontname="Arial", fontsize=20]; node [shape=plain,fontname="Arial",fontsize=11]; edge [fontname="Arial",fontsize=10,color="#6B4B45",arrowsize=0.7];
browser [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#9A3B3B"><TR><TD BGCOLOR="#F6EEDF"><B>Navegador</B></TD></TR><TR><TD ALIGN="LEFT">HTML / CSS / DOM</TD></TR><TR><TD ALIGN="LEFT">Cookie de sesion HttpOnly</TD></TR></TABLE>>];
gateway [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#9A3B3B"><TR><TD BGCOLOR="#F6EEDF"><B>API Gateway :8443</B></TD></TR><TR><TD ALIGN="LEFT">Unica entrada de la aplicacion</TD></TR><TR><TD ALIGN="LEFT">Sirve frontend y rutas permitidas</TD></TR></TABLE>>];
auth [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#9A3B3B"><TR><TD BGCOLOR="#F6EEDF"><B>auth :8501</B></TD></TR><TR><TD ALIGN="LEFT">Cuenta / sesion / verificacion</TD></TR><TR><TD ALIGN="LEFT">auth.sqlite</TD></TR></TABLE>>];
clients [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#9A3B3B"><TR><TD BGCOLOR="#F6EEDF"><B>clients :8502</B></TD></TR><TR><TD ALIGN="LEFT">Perfil / contacto / reserva</TD></TR><TR><TD ALIGN="LEFT">clients.sqlite</TD></TR></TABLE>>];
inventory [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#9A3B3B"><TR><TD BGCOLOR="#F6EEDF"><B>inventory :8503</B></TD></TR><TR><TD ALIGN="LEFT">Producto / stock / reserva</TD></TR><TR><TD ALIGN="LEFT">inventory.sqlite</TD></TR></TABLE>>];
orders [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#9A3B3B"><TR><TD BGCOLOR="#F6EEDF"><B>orders :8504</B></TD></TR><TR><TD ALIGN="LEFT">Pedido / lineas / estados</TD></TR><TR><TD ALIGN="LEFT">orders.sqlite</TD></TR></TABLE>>];
payments [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#9A3B3B"><TR><TD BGCOLOR="#F6EEDF"><B>payments :8505</B></TD></TR><TR><TD ALIGN="LEFT">Pago / evento / reembolso</TD></TR><TR><TD ALIGN="LEFT">payments.sqlite</TD></TR></TABLE>>];
graphql [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#9A3B3B"><TR><TD BGCOLOR="#F6EEDF"><B>GraphQL :8506</B></TD></TR><TR><TD ALIGN="LEFT">Composicion sin base propia</TD></TR><TR><TD ALIGN="LEFT">orders + inventory</TD></TR></TABLE>>];
provider [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#9A3B3B"><TR><TD BGCOLOR="#F6EEDF"><B>provider :8507</B></TD></TR><TR><TD ALIGN="LEFT">Sandbox privado</TD></TR><TR><TD ALIGN="LEFT">Buzon / checkout / geocodificacion</TD></TR></TABLE>>];
secrets [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#9A3B3B"><TR><TD BGCOLOR="#F6EEDF"><B>Secret Manager :8500</B></TD></TR><TR><TD ALIGN="LEFT">Referencias y ACL</TD></TR><TR><TD ALIGN="LEFT">Identidad unica por proceso</TD></TR></TABLE>>];
browser -> gateway [label="HTTPS",style="solid",taillabel="",headlabel="",labeldistance=1.8];
gateway -> auth [label="sesion",style="solid",taillabel="",headlabel="",labeldistance=1.8];
gateway -> clients [label="perfil y formularios",style="solid",taillabel="",headlabel="",labeldistance=1.8];
gateway -> graphql [label="agregacion",style="solid",taillabel="",headlabel="",labeldistance=1.8];
gateway -> orders [label="pedidos",style="solid",taillabel="",headlabel="",labeldistance=1.8];
gateway -> inventory [label="catalogo",style="solid",taillabel="",headlabel="",labeldistance=1.8];
gateway -> payments [label="checkout",style="solid",taillabel="",headlabel="",labeldistance=1.8];
graphql -> orders [label="lectura autorizada",style="solid",taillabel="",headlabel="",labeldistance=1.8];
graphql -> inventory [label="batch",style="solid",taillabel="",headlabel="",labeldistance=1.8];
orders -> inventory [label="reserva / libera",style="solid",taillabel="",headlabel="",labeldistance=1.8];
payments -> orders [label="confirma pago",style="solid",taillabel="",headlabel="",labeldistance=1.8];
auth -> provider [label="correo",style="solid",taillabel="",headlabel="",labeldistance=1.8];
payments -> provider [label="checkout / refund",style="solid",taillabel="",headlabel="",labeldistance=1.8];
gateway -> secrets [label="ACL y referencias, igual en cada servicio",style="dashed",taillabel="",headlabel="",labeldistance=1.8];
photon [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#9A3B3B"><TR><TD BGCOLOR="#F6EEDF"><B>Photon externo</B></TD></TR><TR><TD>Direcciones reales / OpenStreetMap</TD></TR><TR><TD>Internet y disponibilidad requeridos</TD></TR></TABLE>>];
orders -> provider [label="direccion / comprobante"];
provider -> photon [label="HTTPS; direccion; plazo 5s"];
}
