            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Login": {
        "properties": {
          "correo": {
            "type": "string",
            "maxLength": 254,
            "minLength": 5,
            "title": "Correo"
          },
          "clave": {
            "type": "string",
            "maxLength": 128,
            "minLength": 10,
            "title": "Clave"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "correo",
          "clave"
        ],
        "title": "Login"
      },
      "Register": {
        "properties": {
          "correo": {
            "type": "string",
            "maxLength": 254,
            "minLength": 5,
            "title": "Correo"
          },
          "clave": {
            "type": "string",
            "maxLength": 128,
            "minLength": 10,
            "title": "Clave"
          },
          "nombre": {
            "type": "string",
            "maxLength": 100,
            "minLength": 2,
            "title": "Nombre"
          },
          "run": {
            "type": "string",
            "maxLength": 12,
            "minLength": 3,
            "title": "Run"
          },
          "direccion": {
            "type": "string",
            "maxLength": 200,
            "minLength": 5,
            "title": "Direccion"
          },
          "comuna": {
            "type": "string",
            "maxLength": 80,
            "minLength": 2,
            "title": "Comuna"
          },
          "provincia": {
            "type": "string",
            "maxLength": 80,
            "minLength": 2,
            "title": "Provincia"
          },
          "region": {
            "type": "string",
            "maxLength": 80,
            "minLength": 2,
            "title": "Region"
          },
          "nacimiento": {
            "type": "string",
            "format": "date",
            "title": "Nacimiento"
          },
          "sexo": {
            "type": "string",
            "pattern": "^(F|M|Otro|No informar)$",
            "title": "Sexo"
          },
          "telefono": {
            "type": "string",
            "pattern": "^\\+?[0-9 ]{8,16}$",
            "title": "Telefono"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "correo",
          "clave",
          "nombre",
          "run",
          "direccion",
          "comuna",
          "provincia",
          "region",
          "nacimiento",
          "sexo",
          "telefono"
        ],
        "title": "Register"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
